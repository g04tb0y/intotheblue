# Ambiente virtuale (Python 3.10, ricreabile con requirements.txt)
.venv
.venv310

# Output generati dalle scansioni
csv/
*.log

# SQLite persistence (ricreabile; scansioni/GATT salvati dal web/MCP)
db/

# Structured event log (JSONL, ricreabile; attività radio tracciata da engine)
logs/

# Cache Python
__pycache__/
*.pyc

# Config tool serena
.serena/

# Fast Pair anti-spoofing public keys (operator-supplied / fetched cache; see
# fastpair_keys.example.yaml). The live file may hold keys pulled from Google.
fastpair_keys.yaml

# Bluetooth SIG assigned-numbers checkout (authoritative vendor/UUID data)
BluetoothSIGPublic/
